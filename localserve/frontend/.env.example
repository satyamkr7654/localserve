# Browser-visible configuration. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server-only upstream origin for a future Next.js BFF boundary.
BACKEND_API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
