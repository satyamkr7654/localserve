APP_ENVIRONMENT=local
APP_VERSION=dev
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MONGODB_URI=mongodb://mongo:27017/localserve?replicaSet=rs0
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
JWT_ISSUER_URI=https://identity.example.com/realms/localserve
CORS_ALLOWED_ORIGINS=https://app.example.com,https://provider.example.com,https://admin.example.com
ACCESS_TOKEN_TTL=PT10M
REFRESH_TOKEN_TTL=P14D
REMEMBERED_REFRESH_TOKEN_TTL=P60D
SECURE_COOKIES=true
OTP_HMAC_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
BREACHED_PASSWORD_API_URL=https://api.pwnedpasswords.com/range/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
FIREBASE_CREDENTIALS_JSON=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=localserve-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
