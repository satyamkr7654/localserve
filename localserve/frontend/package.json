{
  "name": "localserve-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.9.0",
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
