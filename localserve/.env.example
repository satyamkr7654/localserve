APP_ENVIRONMENT=local
APP_VERSION=dev
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MONGODB_URI=mongodb://mongo:27017/localserve?replicaSet=rs0
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
JWT_ISSUER_URI=https://identity.example.com/realms/localserve
JWT_ISSUER=https://api.localserve.example
JWT_PUBLIC_AUDIENCE=localserve-public
JWT_ADMIN_AUDIENCE=localserve-admin
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
CORS_ALLOWED_ORIGINS=https://app.example.com,https://provider.example.com,https://admin.example.com
ACCESS_TOKEN_TTL=PT10M
REFRESH_TOKEN_TTL=P14D
REMEMBERED_REFRESH_TOKEN_TTL=P60D
SECURE_COOKIES=true
OTP_HMAC_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
BREACHED_PASSWORD_API_URL=https://api.pwnedpasswords.com/range/
BREACHED_PASSWORD_CHECK_ENABLED=true
AUTH_ACTION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-from-a-secret-manager
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/google/callback
GOOGLE_CUSTOMER_RESULT_URL=https://app.example.com/oauth/google/result
GOOGLE_PROVIDER_RESULT_URL=https://provider.example.com/oauth/google/result
AUTH_EMAIL_FROM=no-reply@localserve.example
EMAIL_VERIFICATION_BASE_URL=https://app.example.com/verify-email
PASSWORD_RECOVERY_BASE_URL=https://app.example.com/reset-password
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=LocalServe
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_TOTP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
FIREBASE_CREDENTIALS_JSON=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=localserve-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
